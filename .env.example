# ============================================================
# MathTutor Environment Configuration
# ============================================================

# AWS Bedrock AI Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your-bedrock-model-id

# AWS Bedrock Credentials
# Use BEDROCK_AWS_* on Vercel because Vercel reserves AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
BEDROCK_AWS_ACCESS_KEY_ID=your-bedrock-access-key-id
BEDROCK_AWS_SECRET_ACCESS_KEY=your-bedrock-secret-access-key
# Fallback AWS Credentials (for non-Vercel or IAM role environments)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Distributed Rate Limiting (Upstash Redis)
# If omitted, MathTutor automatically falls back to an in-memory sliding window limiter
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# PostgreSQL Database Connection String (e.g., Neon, Supabase, AWS RDS, or local)
# Optional for chat; required for user auth and chat persistence
DATABASE_URL=postgresql://username:password@hostname:5432/databasename?sslmode=require

# Initial Administrator Provisioning (Used by `npm run seed:admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=System Administrator

# Optional: Local FastAPI MathsLLM Backend (Port 8000)
# BACKEND_URL=http://localhost:8000

# CORS & Mobile API Configuration (Capacitor / Android)
# NEXT_PUBLIC_API_BASE=
# ALLOWED_ORIGINS=https://your-domain.vercel.app
